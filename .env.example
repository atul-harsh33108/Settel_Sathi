# Application
SETTLESAATHI_ENV=development
SETTLESAATHI_LOG_LEVEL=INFO
SETTLESAATHI_API_PREFIX=/api/v1
SETTLESAATHI_CORS_ORIGINS=http://localhost:5173

# Local-only Release 0 storage. These paths must remain private and uncommitted.
SETTLESAATHI_DATABASE_URL=sqlite:///./data/settlesaathi.db
SETTLESAATHI_STORAGE_DIR=storage

# Keep empty to use deterministic agent behavior. Never commit a real API key.
SETTLESAATHI_LLM_API_KEY=
SETTLESAATHI_LLM_MODEL=
